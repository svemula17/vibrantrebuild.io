{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vibrant-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "static-out",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "out",
        "-l",
        "4180",
        "--no-clipboard"
      ],
      "port": 4180
    }
  ]
}